# Backend environment — copy to backend/.env
# Validated by backend/src/env.ts (Zod). Full reference: ../.env.example

# PostgreSQL 16 + PostGIS connection string.
DATABASE_URL="postgresql://krystal:krystal_dev_password@localhost:5432/roofdynamics?schema=public"
# JWT signing secret (32+ chars in production).
JWT_SECRET="roofdynamics-dev-secret-change-in-production"
# API server port.
PORT=5000
# Allowed CORS origin.
CLIENT_URL="http://localhost:5173"
# Runtime mode: development | production | test.
NODE_ENV=development

# Local OpenAI-compatible LLM endpoint (optional).
AI_LLM_ENDPOINT="http://localhost:1234/v1"
# Local LLM API key (optional; empty = deterministic fallback).
AI_API_KEY=""
# ATO ABR GUID for live ABN lookups (empty = offline checksum).
ABR_GUID=""
# Log verbosity: debug | info | warn | error.
LOG_LEVEL="info"

# Supabase Auth (phase 1.5).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis + Inngest (phase 1.6).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Local dev mode (true) or production signing-key verification (false).
INNGEST_DEV=true

# Sentry (phase 1.7).
SENTRY_DSN=""

# Cloudflare R2 / AWS S3 storage (phase 3.6).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Mapbox token for server-side geocoding (phase 2.3).
MAPBOX_TOKEN=""

# Stripe billing (phase 3.5).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# B2B credentials (phase 3.2). Empty = deterministic sandbox.
GREENSKY_API_KEY=""
NOAA_API_KEY=""
ABC_SUPPLY_API_KEY=""
BEACON_API_KEY=""
XACTIMATE_API_KEY=""
# Sandbox integration toggle (phase 4.1). Keep true until contracts approved.
ENABLE_MOCK_INTEGRATIONS=true
