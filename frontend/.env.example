# Frontend environment — copy to frontend/.env
# Validated by frontend/src/env.ts (Zod). Full reference: ../.env.example
# NOTE: Vite only exposes variables prefixed with VITE_ to client code.

# Base URL for REST calls. Relative "/api" uses the Vite/Netlify proxy.
VITE_API_BASE="/api"

# Local OpenAI-compatible LLM endpoint (optional).
VITE_AI_LLM_ENDPOINT="http://localhost:1234/v1"
# Local LLM API key (optional).
VITE_AI_API_KEY=""

# Supabase Auth (phase 1.5) — anon key only; never put service role here.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Mapbox GL JS token (phases 2.3, 2.4).
VITE_MAPBOX_TOKEN=""

# Sentry DSN (phase 1.7).
VITE_SENTRY_DSN=""

# Stripe publishable key (phase 3.5).
VITE_STRIPE_PUBLISHABLE_KEY=""

# Public storage base URL (phase 3.6).
VITE_R2_PUBLIC_URL=""

# Notification providers: mock | resend | sendgrid / mock | twilio.
VITE_EMAIL_PROVIDER="mock"
VITE_SMS_PROVIDER="mock"

# Sandbox integration toggle (phase 4.1). Keep true until contracts approved.
VITE_ENABLE_MOCK_INTEGRATIONS=true
