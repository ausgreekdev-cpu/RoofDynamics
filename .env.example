# ============================================================================
# Roof Dynamics — CANONICAL ENVIRONMENT REFERENCE
# Copy the relevant block into backend/.env and frontend/.env.
# Every variable is validated by Zod in backend/src/env.ts and frontend/src/env.ts.
# Never commit real secrets. Guardrail #5: document every new variable here.
# ============================================================================

# ----------------------------------------------------------------------------
# CORE (backend) — required for local development
# ----------------------------------------------------------------------------
# PostgreSQL 16 connection string. PostGIS extension must be enabled.
DATABASE_URL="postgresql://user:password@localhost:5432/roofdynamics?schema=public"
# JWT signing secret. Use 32+ random chars in production.
JWT_SECRET="change-me"
# API server port.
PORT=5000
# Allowed browser origin for CORS (the frontend dev/prod URL).
CLIENT_URL="http://localhost:5173"
# Runtime mode: development | production | test.
NODE_ENV=development

# ----------------------------------------------------------------------------
# LOCAL AI BRIDGE (backend + frontend) — optional
# ----------------------------------------------------------------------------
# OpenAI-compatible local LLM endpoint (LM Studio / Qwen / Llama).
AI_LLM_ENDPOINT="http://localhost:1234/v1"
# API key for the local LLM or hosted provider. Empty = deterministic fallback.
AI_API_KEY=""
# Client-side mirror of the LLM endpoint (VITE_ prefix required by Vite).
VITE_AI_LLM_ENDPOINT="http://localhost:1234/v1"
# Client-side mirror of the LLM API key.
VITE_AI_API_KEY=""

# ----------------------------------------------------------------------------
# API ROUTING (frontend)
# ----------------------------------------------------------------------------
# Base URL for REST API calls. Relative "/api" uses the Vite/Netlify proxy.
VITE_API_BASE="/api"

# Serve API requests from the deterministic localStorage-backed sandbox instead
# of a hosted backend. Enabled in the production demo deployment; keep false in
# local development so the real Express API is used.
VITE_USE_SANDBOX_API=false

# ----------------------------------------------------------------------------
# SUPABASE AUTH (phase 1.5) — JWT + OAuth
# ----------------------------------------------------------------------------
# Supabase project URL (server-side).
SUPABASE_URL=""
# Supabase publishable/anon key (safe for client).
SUPABASE_ANON_KEY=""
# Supabase service role key (SERVER ONLY — never expose to client).
SUPABASE_SERVICE_ROLE_KEY=""
# Client mirror of the Supabase project URL.
VITE_SUPABASE_URL=""
# Client mirror of the anon key.
VITE_SUPABASE_ANON_KEY=""

# ----------------------------------------------------------------------------
# CACHE & QUEUES (phase 1.6)
# ----------------------------------------------------------------------------
# Upstash Redis REST URL for rate limiting & geospatial cache.
UPSTASH_REDIS_REST_URL=""
# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=""
# Inngest event key for emitting background jobs.
INNGEST_EVENT_KEY=""
# Inngest signing key for webhook verification.
INNGEST_SIGNING_KEY=""
# Set true for local Inngest dev mode (no signing key required). False in prod.
INNGEST_DEV=false

# ----------------------------------------------------------------------------
# MAPS & 3D (phases 2.3, 2.4)
# ----------------------------------------------------------------------------
# Mapbox access token (GL JS + geocoding scopes).
MAPBOX_TOKEN=""
# Client mirror of the Mapbox token.
VITE_MAPBOX_TOKEN=""

# ----------------------------------------------------------------------------
# PDF & OBJECT STORAGE (phases 2.5, 3.6)
# ----------------------------------------------------------------------------
# Cloudflare R2 account ID.
R2_ACCOUNT_ID=""
# R2 API access key ID.
R2_ACCESS_KEY_ID=""
# R2 API secret access key.
R2_SECRET_ACCESS_KEY=""
# R2 bucket name for generated PDFs and roof photos.
R2_BUCKET=""
# Public base URL for the R2 bucket.
R2_PUBLIC_URL=""
# AWS region (alternative S3 provider).
AWS_REGION=""
# AWS access key ID (alternative S3 provider).
AWS_ACCESS_KEY_ID=""
# AWS secret access key (alternative S3 provider).
AWS_SECRET_ACCESS_KEY=""
# Client mirror of the public storage URL.
VITE_R2_PUBLIC_URL=""

# ----------------------------------------------------------------------------
# BILLING (phase 3.5) — Stripe
# ----------------------------------------------------------------------------
# Stripe secret key (SERVER ONLY).
STRIPE_SECRET_KEY=""
# Stripe webhook signing secret (SERVER ONLY).
STRIPE_WEBHOOK_SECRET=""
# Stripe publishable key (safe for client).
STRIPE_PUBLISHABLE_KEY=""
# Client mirror of the Stripe publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=""

# ----------------------------------------------------------------------------
# OBSERVABILITY (phase 1.7)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking (server).
SENTRY_DSN=""
# Sentry DSN for error tracking (client).
VITE_SENTRY_DSN=""
# Log verbosity: debug | info | warn | error.
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (phase 4.1)
# ----------------------------------------------------------------------------
# B2B integration credentials (phase 3.2). Empty = deterministic sandbox adapter.
GREENSKY_API_KEY=""
NOAA_API_KEY=""
ABC_SUPPLY_API_KEY=""
BEACON_API_KEY=""
XACTIMATE_API_KEY=""
# Use deterministic sandbox adapters when true. Set false only after B2B
# contracts and live credentials are approved (human action).
ENABLE_MOCK_INTEGRATIONS=true
VITE_ENABLE_MOCK_INTEGRATIONS=true
# ATO ABR GUID for live ABN lookups. Empty = offline checksum validation.
ABR_GUID=""
# Notification provider selectors: mock | resend | sendgrid / mock | twilio.
VITE_EMAIL_PROVIDER="mock"
VITE_SMS_PROVIDER="mock"
